---
id: sign-in-action-visual
name: Sign-in Action Preview
description: A static visual action treatment for a primary or alternative sign-in option.
category: Forms/Sign-in
attributes:
  label:
    type: string
    default: Continue
    overridable: true
  variant:
    type: list
    options:
      - primary
      - secondary
    default: primary
    overridable: true
  mark:
    type: string
    default: ""
    overridable: true
---
<style>
  .openux-sign-in-action {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 46px;
    margin-top: 20px;
    border-radius: 9px;
    font: 700 12px/1.4 Inter, "Segoe UI", Arial, sans-serif;
    text-align: center;
  }
  .openux-sign-in-action--primary {
    background: var(--theme-primary, #4569e8);
    box-shadow: 0 8px 16px color-mix(in srgb, var(--theme-primary, #4569e8) 23%, transparent);
    color: var(--theme-on-primary, #fff);
    letter-spacing: .01em;
  }
  .openux-sign-in-action--secondary {
    min-height: 44px;
    margin-top: 0;
    border: 1px solid var(--theme-border, #dfe4ed);
    background: var(--theme-surface, #fff);
    color: var(--theme-ink, #1e293b);
    font-size: 11px;
    font-weight: 650;
  }
  .openux-sign-in-action__mark:empty { display: none; }
  .openux-sign-in-action--secondary .openux-sign-in-action__mark {
    color: #4285f4;
    font-size: 16px;
    font-weight: 750;
  }
  .openux-sign-in-action--primary .openux-sign-in-action__arrow::before { content: "→"; }
</style>
<div class="openux-sign-in-action openux-sign-in-action--${attributes.variant}" aria-label="Decorative ${attributes.label} preview">
  <span class="openux-sign-in-action__mark" aria-hidden="true">${attributes.mark}</span>
  <span>${attributes.label}</span>
  <span class="openux-sign-in-action__arrow" aria-hidden="true"></span>
</div>
